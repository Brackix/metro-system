{
  "expo": {
    "name": "metro-app",
    "slug": "metro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metroapp",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Esta app usa huella digital para acceso rápido y seguro.",
        "NSLocationWhenInUseUsageDescription": "Permitir que la app use tu ubicación para mostrar estaciones cercanas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.metroapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.NFC"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que la app use tu ubicación para mostrar estaciones cercanas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Esta app usa huella digital para acceso rápido y seguro a tu cuenta."
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/react-native-vector-icons/Fonts/Ionicons.ttf",
            "node_modules/react-native-vector-icons/Fonts/MaterialIcons.ttf",
            "node_modules/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf",
            "node_modules/react-native-vector-icons/Fonts/FontAwesome.ttf"
          ]
        }
      ]
    ],
    "owner": "robert22f",
    "extra": {
      "eas": {
        "projectId": "1d9a58e7-3639-437b-8be0-f86aa1fed466"
      }
    }
  }
}