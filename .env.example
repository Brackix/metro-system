# ==============================================================================
#  Metro System — Environment Configuration
#  Copy to .env and edit as needed:  cp .env.example .env
# ==============================================================================

# ── Database ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=metroapp
DB_PORT=5432

# ── Backend API ──────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ── Frontend / Mobile ────────────────────────────────────────────────────────────
API_URL=http://localhost:4000/api

# ── Dashboard ────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── Web Turnstile ────────────────────────────────────────────────────────────────
TURNSTILE_PORT=5000

# ── Prisma (composed from vars above) ────────────────────────────────────────────
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}?schema=public"
